# Copy to .env.local for local development. Never commit .env.local.
# Full reference: docs/IMPLEMENTATION_PLAN.md section 15.

# ---- Phase 1 ----
# Canonical origin. Set ONLY in the Vercel Production environment; previews fall back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=
# 1, 2, or 3. Both must match. Default 1.
APP_PHASE=1
NEXT_PUBLIC_APP_PHASE=1
# Cloudflare R2 public base URL (custom domain or r2.dev). Optional until the first video is ready.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Analytics slots. Empty = nothing loads.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---- Phase 2 ----
DATABASE_URL=
DATABASE_URL_UNPOOLED=
RESEND_API_KEY=
RESEND_SEGMENT_ID=
OWNER_EMAIL=
IP_HASH_SALT=

# ---- Phase 3 ----
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
CRON_ENABLED=
RESEND_WEBHOOK_SECRET=

# ---- Later ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
